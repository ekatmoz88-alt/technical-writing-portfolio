<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_AS_FB_DROND"
  targetNamespace="https://ekatmoz88-alt.github.io/technical-writing-portfolio/as-fb-drond">
  <bpmn:process id="Process_BudgetPlanning" name="АС ФБ и ДРОНД — формирование бюджетных предложений, РРО и ОБАС" isExecutable="false">
    <bpmn:laneSet id="LaneSet_BudgetPlanning">
      <bpmn:lane id="Lane_GRBS" name="ГРБС / подведомственные распорядители">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareProposals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitProposals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareRRO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitRRO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareOBAS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitOBAS</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Ministry" name="Минобрнауки России">
        <bpmn:flowNodeRef>Task_AggregateCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExportProposals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApproveRRO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExportRRO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MapPowersObligations</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApproveOBAS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExportOBAS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_1" name="Начало бюджетного цикла"/>
    <bpmn:task id="Task_PrepareProposals" name="Подготовить предложения по распределению БА"/>
    <bpmn:userTask id="Task_SubmitProposals" name="Передать предложения на согласование и утверждение"/>
    <bpmn:task id="Task_AggregateCheck" name="Агрегировать и проверить предложения"/>
    <bpmn:task id="Task_ExportProposals" name="Экспортировать утверждённые предложения в формате Минфина"/>
    <bpmn:task id="Task_PrepareRRO" name="Сформировать плановый РРО"/>
    <bpmn:userTask id="Task_SubmitRRO" name="Передать РРО и сведения по ПНО на согласование"/>
    <bpmn:userTask id="Task_ApproveRRO" name="Согласовать и утвердить РРО"/>
    <bpmn:task id="Task_ExportRRO" name="Экспортировать РРО в формате Минфина"/>
    <bpmn:task id="Task_MapPowersObligations" name="Сопоставить расходные полномочия и обязательства"/>
    <bpmn:task id="Task_PrepareOBAS" name="Подготовить ОБАС для каждого бюджетного ассигнования"/>
    <bpmn:userTask id="Task_SubmitOBAS" name="Передать ОБАС на согласование и утверждение"/>
    <bpmn:userTask id="Task_ApproveOBAS" name="Согласовать и утвердить ОБАС"/>
    <bpmn:task id="Task_ExportOBAS" name="Экспортировать ОБАС в формате Минфина"/>
    <bpmn:endEvent id="EndEvent_1" name="Завершение подготовки пакета"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_1" targetRef="Task_PrepareProposals"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_PrepareProposals" targetRef="Task_SubmitProposals"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_SubmitProposals" targetRef="Task_AggregateCheck"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_AggregateCheck" targetRef="Task_ExportProposals"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_ExportProposals" targetRef="Task_PrepareRRO"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_PrepareRRO" targetRef="Task_SubmitRRO"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_SubmitRRO" targetRef="Task_ApproveRRO"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_ApproveRRO" targetRef="Task_ExportRRO"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_ExportRRO" targetRef="Task_MapPowersObligations"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_MapPowersObligations" targetRef="Task_PrepareOBAS"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_PrepareOBAS" targetRef="Task_SubmitOBAS"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_SubmitOBAS" targetRef="Task_ApproveOBAS"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_ApproveOBAS" targetRef="Task_ExportOBAS"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_ExportOBAS" targetRef="EndEvent_1"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_BudgetPlanning">
    <bpmndi:BPMNPlane id="BPMNPlane_BudgetPlanning" bpmnElement="Process_BudgetPlanning">
      <bpmndi:BPMNShape id="Shape_Lane_GRBS" bpmnElement="Lane_GRBS" isHorizontal="true">
        <dc:Bounds x="20" y="20" width="2550" height="190"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Ministry" bpmnElement="Lane_Ministry" isHorizontal="true">
        <dc:Bounds x="20" y="210" width="2550" height="190"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StartEvent_1" bpmnElement="StartEvent_1">
        <dc:Bounds x="65" y="92" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_PrepareProposals" bpmnElement="Task_PrepareProposals">
        <dc:Bounds x="140" y="70" width="135" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_SubmitProposals" bpmnElement="Task_SubmitProposals">
        <dc:Bounds x="310" y="70" width="135" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_AggregateCheck" bpmnElement="Task_AggregateCheck">
        <dc:Bounds x="480" y="265" width="135" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ExportProposals" bpmnElement="Task_ExportProposals">
        <dc:Bounds x="650" y="265" width="135" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_PrepareRRO" bpmnElement="Task_PrepareRRO">
        <dc:Bounds x="820" y="70" width="135" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_SubmitRRO" bpmnElement="Task_SubmitRRO">
        <dc:Bounds x="990" y="70" width="135" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ApproveRRO" bpmnElement="Task_ApproveRRO">
        <dc:Bounds x="1160" y="265" width="135" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ExportRRO" bpmnElement="Task_ExportRRO">
        <dc:Bounds x="1330" y="265" width="135" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_MapPowersObligations" bpmnElement="Task_MapPowersObligations">
        <dc:Bounds x="1500" y="265" width="135" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_PrepareOBAS" bpmnElement="Task_PrepareOBAS">
        <dc:Bounds x="1670" y="70" width="135" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_SubmitOBAS" bpmnElement="Task_SubmitOBAS">
        <dc:Bounds x="1840" y="70" width="135" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ApproveOBAS" bpmnElement="Task_ApproveOBAS">
        <dc:Bounds x="2010" y="265" width="135" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ExportOBAS" bpmnElement="Task_ExportOBAS">
        <dc:Bounds x="2180" y="265" width="135" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_1" bpmnElement="EndEvent_1">
        <dc:Bounds x="2370" y="92" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_Flow_01" bpmnElement="Flow_01"><di:waypoint x="101" y="110"/><di:waypoint x="140" y="110"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_02" bpmnElement="Flow_02"><di:waypoint x="275" y="110"/><di:waypoint x="310" y="110"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_03" bpmnElement="Flow_03"><di:waypoint x="445" y="110"/><di:waypoint x="462" y="110"/><di:waypoint x="462" y="305"/><di:waypoint x="480" y="305"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_04" bpmnElement="Flow_04"><di:waypoint x="615" y="305"/><di:waypoint x="650" y="305"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_05" bpmnElement="Flow_05"><di:waypoint x="785" y="305"/><di:waypoint x="802" y="305"/><di:waypoint x="802" y="110"/><di:waypoint x="820" y="110"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_06" bpmnElement="Flow_06"><di:waypoint x="955" y="110"/><di:waypoint x="990" y="110"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_07" bpmnElement="Flow_07"><di:waypoint x="1125" y="110"/><di:waypoint x="1142" y="110"/><di:waypoint x="1142" y="305"/><di:waypoint x="1160" y="305"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_08" bpmnElement="Flow_08"><di:waypoint x="1295" y="305"/><di:waypoint x="1330" y="305"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_09" bpmnElement="Flow_09"><di:waypoint x="1465" y="305"/><di:waypoint x="1500" y="305"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_10" bpmnElement="Flow_10"><di:waypoint x="1635" y="305"/><di:waypoint x="1652" y="305"/><di:waypoint x="1652" y="110"/><di:waypoint x="1670" y="110"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_11" bpmnElement="Flow_11"><di:waypoint x="1805" y="110"/><di:waypoint x="1840" y="110"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_12" bpmnElement="Flow_12"><di:waypoint x="1975" y="110"/><di:waypoint x="1992" y="110"/><di:waypoint x="1992" y="305"/><di:waypoint x="2010" y="305"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_13" bpmnElement="Flow_13"><di:waypoint x="2145" y="305"/><di:waypoint x="2180" y="305"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_14" bpmnElement="Flow_14"><di:waypoint x="2315" y="305"/><di:waypoint x="2340" y="305"/><di:waypoint x="2340" y="110"/><di:waypoint x="2370" y="110"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
